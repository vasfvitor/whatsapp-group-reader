{
  "name": "whatsapp-group-reader",
  "version": "0.1.0",
  "description": "Leitor local e somente leitura de mensagens autorizadas do WhatsApp.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/patch-wwebjs.mjs && run-p dev:web dev:server",
    "patch:wwebjs": "node scripts/patch-wwebjs.mjs",
    "dev:web": "vite",
    "dev:server": "cross-env APP_DEV=true tsx watch server/index.ts",
    "build": "node scripts/patch-wwebjs.mjs && run-s type-check build:web build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json && node scripts/copy-server-assets.mjs",
    "start": "node dist/server/server/index.js",
    "package:win": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/package-win.ps1",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest",
    "type-check": "run-p type-check:web type-check:server",
    "type-check:web": "vue-tsc --build",
    "type-check:server": "tsc -p tsconfig.server.json --noEmit",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint:check": "oxlint . && eslint .",
    "format": "prettier --write --experimental-cli src/ server/ shared/"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.101.4",
    "env-paths": "^3.0.0",
    "express": "^5.1.0",
    "open": "^11.0.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.38",
    "whatsapp-web.js": "1.34.7",
    "write-file-atomic": "^7.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/express": "^5.0.3",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/eslint-plugin": "^1.6.20",
    "@vue/eslint-config-typescript": "^14.8.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.69.0",
    "eslint-plugin-vue": "~10.9.2",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.69.0",
    "prettier": "3.8.4",
    "supertest": "^7.2.2",
    "tsx": "^4.20.6",
    "typescript": "~6.0.0",
    "vite": "^8.0.16",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vitest": "^4.1.9",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "puppeteer"
    ]
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
}
